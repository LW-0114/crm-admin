@{
    Layout = "_Layout";
    dynamic c = Model;
}

<h3>Dashboard</h3>
<p>Quick overview of training and onboarding activity.</p>

<div class="card-grid">
  <article class="card">
    <h4>Users</h4>
    <p><strong>@c.UsersCount</strong></p>
    <small>Users in the system</small>
  </article>

  <article class="card">
    <h4>Videos</h4>
    <p><strong>@c.VideosCount</strong></p>
    <small>Training videos available</small>
  </article>

  <article class="card">
    <h4>Onboarding</h4>
    <p><strong>@c.OnboardingCount</strong></p>
    <small>Onboarding records</small>
  </article>

  <article class="card">
    <h4>Sessions</h4>
    <p><strong>@c.SessionsCount</strong></p>
    <small>Training sessions scheduled</small>
  </article>
</div>

<p style="margin-top:1.5rem;">
  <a href="/Onboarding">View onboarding</a> ·
  <a href="/Videos">View videos</a> ·
  <a href="/Sessions">View sessions</a>
</p>
